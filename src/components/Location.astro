<!-- Location -->
<section class="border-t border-white/10">
    <div class="mx-auto max-w-6xl py-16 px-8 md:px-0">
        <div class="grid md:grid-cols-2 gap-12">
            <div>
                <div class="small-headline mb-4">/location</div>
                <div
                    class="font-display text-5xl md:text-7xl font-bold uppercase tracking-tight mb-8"
                >
                    Centro Champalimaud For the Unknown. Belém, Lisbon.
                </div>
                <p>
                    A riverfront research center campus in Belém with bright
                    interiors, clean lines and space for technical conversations
                    to spill outside. Easy to reach from central Lisbon by
                    train, taxi bus or rideshare.
                </p>
            </div>
            <div class="md:pl-8" data-venue-grid data-base={import.meta.env.BASE_URL}>
                <div>
                    <img data-venue-main class="w-full rounded-lg" />
                </div>
                <div class="grid grid-cols-3 gap-4 mt-4">
                    <img data-venue-thumb class="w-full rounded-lg" />
                    <img data-venue-thumb class="w-full rounded-lg" />
                    <img data-venue-thumb class="w-full rounded-lg" />
                </div>
            </div>
        </div>
    </div>
</section>

<script is:inline>
    (() => {
        const grid = document.querySelector("[data-venue-grid]");
        if (!grid) return;
        const base = grid.dataset.base;
        const order = [1, 2, 3, 4].sort(() => Math.random() - 0.5);
        grid.querySelector("[data-venue-main]").src =
            `${base}images/venue/${order[0]}.jpg`;
        grid.querySelectorAll("[data-venue-thumb]").forEach((img, i) => {
            img.src = `${base}images/venue/${order[i + 1]}.jpg`;
        });
    })();
</script>
