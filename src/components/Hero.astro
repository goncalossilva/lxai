---
import LatentField from "./LatentField.astro";
---

<!-- Hero -->
<section class="relative min-h-[90vh] overflow-hidden">
    <LatentField
        class="absolute inset-y-0 right-0 h-full w-full md:w-4/5"
    />

    <div
        class="relative mx-auto flex min-h-[90vh] flex-col justify-end px-8 pb-24 pt-16 md:pt-28"
    >
        <div>
            <a
                href="https://x.com/lisbonai_"
                class="text-[11px] uppercase font-mono mb-8 bg-white/10 px-2.5 py-1.5 rounded-sm inline-block"
            >
                We're on X &rarr;
            </a>
        </div>

        <h1 class="big-headline">LISBON AI</h1>
        <div class="mt-8 max-w-xl text-xl leading-snug text-muted">
            2 days. 400 builders.<br />
            Join us September 23-24.
        </div>
    </div>
</section>
