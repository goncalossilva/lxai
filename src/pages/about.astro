---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Location from "../components/Location.astro";
import {
    aboutPhotos,
    type AboutPhotoKind,
    type AboutPhotoOrientation,
} from "../data/aboutPhotos";

type AboutPhotoSlotName = "hero" | "portrait" | "secondary" | "detail";

type AboutPhotoSlot = {
    name: AboutPhotoSlotName;
    orientation: AboutPhotoOrientation;
    kinds?: AboutPhotoKind[];
};

const withBaseUrl = (photo: (typeof aboutPhotos)[number]) => ({
    ...photo,
    src: `${import.meta.env.BASE_URL}${photo.src}`,
});

const aboutPhotoPool = aboutPhotos.map(withBaseUrl);

const heroSlot: AboutPhotoSlot = {
    name: "hero",
    orientation: "horizontal",
    kinds: ["context"],
};
const portraitSlot: AboutPhotoSlot = {
    name: "portrait",
    orientation: "vertical",
};
const secondarySlot: AboutPhotoSlot = {
    name: "secondary",
    orientation: "horizontal",
    kinds: ["talk"],
};
const detailSlot: AboutPhotoSlot = {
    name: "detail",
    orientation: "horizontal",
    kinds: ["community", "detail"],
};

const photoSlots = [heroSlot, portraitSlot, secondarySlot, detailSlot];

const matchesPhotoSlot = (
    photo: (typeof aboutPhotoPool)[number],
    slot: AboutPhotoSlot,
) =>
    photo.orientation === slot.orientation &&
    (!slot.kinds || slot.kinds.includes(photo.kind));

const findFallbackPhoto = (slot: AboutPhotoSlot) =>
    aboutPhotoPool.find((photo) => matchesPhotoSlot(photo, slot)) ??
    aboutPhotoPool.find((photo) => photo.orientation === slot.orientation) ??
    aboutPhotoPool[0];

const fallbackPhotos = {
    hero: findFallbackPhoto(heroSlot),
    portrait: findFallbackPhoto(portraitSlot),
    secondary: findFallbackPhoto(secondarySlot),
    detail: findFallbackPhoto(detailSlot),
};
---

<Layout>
    <Header />

    <!-- Photos -->
    <section class="border-t border-white/10">
        <div class="mx-auto max-w-6xl py-16 px-8 md:px-0">
            <div class="small-headline mb-4">/know-more</div>
            <h1 class="text-2xl mb-8">About Lisbon AI</h1>

            <div class="grid gap-6 md:grid-cols-12 md:gap-8">
                <figure
                    class="aspect-[3/2] overflow-hidden rounded-2xl bg-white/[0.03] md:col-span-7"
                >
                    <img
                        data-about-photo-slot="hero"
                        src={fallbackPhotos.hero.src}
                        alt={fallbackPhotos.hero.alt}
                        class="h-full w-full object-cover transition-opacity duration-500 motion-reduce:transition-none"
                        style={`object-position: ${fallbackPhotos.hero.position}`}
                        decoding="async"
                        fetchpriority="high"
                    />
                </figure>

                <figure
                    class="aspect-[4/5] max-h-[70vh] overflow-hidden rounded-2xl bg-white/[0.03] md:col-span-5 md:row-span-2 md:h-full md:max-h-none md:aspect-auto"
                >
                    <img
                        data-about-photo-slot="portrait"
                        src={fallbackPhotos.portrait.src}
                        alt={fallbackPhotos.portrait.alt}
                        class="h-full w-full object-cover transition-opacity duration-500 motion-reduce:transition-none"
                        style={`object-position: ${fallbackPhotos.portrait.position}`}
                        decoding="async"
                    />
                </figure>

                <figure
                    class="aspect-[3/2] overflow-hidden rounded-2xl bg-white/[0.03] md:col-span-4"
                >
                    <img
                        data-about-photo-slot="secondary"
                        src={fallbackPhotos.secondary.src}
                        alt={fallbackPhotos.secondary.alt}
                        class="h-full w-full object-cover transition-opacity duration-500 motion-reduce:transition-none"
                        style={`object-position: ${fallbackPhotos.secondary.position}`}
                        decoding="async"
                        loading="lazy"
                    />
                </figure>

                <figure
                    class="aspect-[3/2] overflow-hidden rounded-2xl bg-white/[0.03] md:col-span-3 md:h-full md:aspect-auto"
                >
                    <img
                        data-about-photo-slot="detail"
                        src={fallbackPhotos.detail.src}
                        alt={fallbackPhotos.detail.alt}
                        class="h-full w-full object-cover transition-opacity duration-500 motion-reduce:transition-none"
                        style={`object-position: ${fallbackPhotos.detail.position}`}
                        decoding="async"
                        loading="lazy"
                    />
                </figure>
            </div>

            <script define:vars={{ aboutPhotoPool, photoSlots }}>
                const selectedSources = new Set();

                const matchesPhotoSlot = (photo, slot) =>
                    photo.orientation === slot.orientation &&
                    (!slot.kinds || slot.kinds.includes(photo.kind));

                const availablePhotos = (slot, strict = true) =>
                    aboutPhotoPool.filter(
                        (photo) =>
                            !selectedSources.has(photo.src) &&
                            (strict
                                ? matchesPhotoSlot(photo, slot)
                                : photo.orientation === slot.orientation),
                    );

                const randomPhoto = (slot) => {
                    const candidates = availablePhotos(slot);
                    const fallbackCandidates = availablePhotos(slot, false);
                    const pool =
                        candidates.length > 0 ? candidates : fallbackCandidates;

                    if (pool.length === 0) return null;

                    const photo = pool[Math.floor(Math.random() * pool.length)];
                    selectedSources.add(photo.src);
                    return photo;
                };

                for (const slot of photoSlots) {
                    const photo = randomPhoto(slot);
                    const image = document.querySelector(
                        `[data-about-photo-slot="${slot.name}"]`,
                    );

                    if (!photo || !image) continue;

                    image.classList.add("opacity-0");
                    image.addEventListener(
                        "load",
                        () => image.classList.remove("opacity-0"),
                        { once: true },
                    );
                    image.src = photo.src;
                    image.alt = photo.alt;
                    image.style.objectPosition = photo.position;

                    if (image.complete) {
                        image.classList.remove("opacity-0");
                    }
                }
            </script>
        </div>
    </section>

    <section class="border-t border-white/10">
        <div class="mx-auto max-w-6xl py-16 px-8 md:px-0">
            <div class="grid md:grid-cols-2 gap-8">
                <div>
                    <div class="small-headline mb-4">/what-to-expect</div>
                    <p class="text-xl mb-8">
                        Lisbon AI started as a not‑so‑quiet group chat of
                        hackers reminiscing about LXJS and wondering why there
                        wasn’t a European, builder‑first AI gathering. We fixed
                        that in 2025, and we're back for more in 2026.
                    </p>
                </div>
                <div class="md:px-12">
                    <ul class="text-xl">
                        <li class="mb-4">
                            Community-run<br />
                            <span class="text-muted"
                                >Organized by people who ship open-source for a
                                living. Volunteer based.</span
                            >
                        </li>
                        <li class="mb-4 border-t border-white/10 pt-4">
                            Single‑track talks, multi‑track fun<br />
                            <span class="text-muted"
                                >You never miss a talk, but you choose your own
                                dinners, workshops, and hackathon projects.</span
                            >
                        </li>
                        <li class="mb-4 border-t border-white/10 pt-4">
                            Open-source<br />
                            <span class="text-muted"
                                >Every speaker presents the code. Every talk is
                                live-streamed.</span
                            >
                        </li>
                        <li class="mb-4 border-t border-white/10 pt-4">
                            Ethical by design<br />
                            <span class="text-muted"
                                >Code of conduct, diverse curation, and
                                scholarships baked in</span
                            >
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </section>

    <Location />

    <Footer />
</Layout>
